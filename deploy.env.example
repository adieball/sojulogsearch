# Copy to deploy.env and adjust. deploy.sh reads it on every run.

# Where the app listens. Keep it on localhost if the reverse proxy runs on the
# same machine; use an internal address if the proxy is on another host.
SLS_BIND=127.0.0.1:8090

# IP(s) of the reverse proxy, comma-separated. Only needed when the proxy runs
# on another host; lets the app see the real client IP for login rate limiting.
#SLS_TRUSTED_PROXIES=10.0.0.5

# How to reach soju for the login check (one of soju's "listen" addresses).
SOJU_HOST=127.0.0.1
SOJU_PORT=6697
SOJU_TLS=1
# Hostname on soju's TLS certificate (the "hostname" / "tls" in soju's config).
SOJU_TLS_NAME=soju.example.org

# soju's "message-store fs" directory.
SOJU_LOG_DIR=/var/lib/soju/logs
